# ── statarb_live environment (copy to .env, fill in, never commit the real .env) ──
# All operational knobs use the SAL_ prefix; MT5 creds reuse the repo-wide MT5_* names.

# Mode / broker -------------------------------------------------------------
SAL_MODE=paper            # paper | live
SAL_BROKER=sim            # sim (Linux/Docker, file-backed) | mt5 (Windows VPS)
SAL_TIMEFRAME=H1

# Data ----------------------------------------------------------------------
SAL_DATA_DIR=notebooks/data
SAL_BROKER_TZ=Europe/Nicosia

# Storage -------------------------------------------------------------------
# Leave SAL_DB_URL empty for local SQLite; set it for the VPS Postgres.
# SAL_DB_URL=postgresql+psycopg://statarb:statarb@db:5432/statarb
SAL_DB_URL=

# Capital / risk envelope (fractions of equity) -----------------------------
SAL_STARTING_EQUITY=100000
SAL_MAX_DAILY_LOSS_PCT=0.02
SAL_MAX_WEEKLY_LOSS_PCT=0.05
SAL_MAX_GROSS_EXPOSURE=4.0
SAL_MAX_POSITION_PCT=1.0

# Postgres (docker-compose) -------------------------------------------------
POSTGRES_USER=statarb
POSTGRES_PASSWORD=statarb
POSTGRES_DB=statarb

# MT5 demo account (Windows VPS, live mode) ---------------------------------
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_TERMINAL_PATH=
