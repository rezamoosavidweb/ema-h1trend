# Ignore everything under notebooks/data EXCEPT the stat_arb outputs
# (strategy artifacts that the live pairs-trading runner depends on).
/notebooks/data/*
!/notebooks/data/stat_arb/
/notebooks/data/stat_arb/live_signals/

# Ignore everything under notebooks/results EXCEPT the multi_symbol_scalper
# outputs (golden basket + per-symbol stats that the live runner reads).
/notebooks/results/*
!/notebooks/results/multi_symbol_scalper/

# Broker account exports (sensitive — account numbers, balances, trade history).
/errante-report/

# statarb_live (Phase 5) runtime outputs — SQLite DBs, reports, logs are not committed.
# EXCEPTION: the frozen universe.json IS committed so a fresh server (with no H1 CSV
# cache) can load the exact same pair book without re-running the formation selection.
# DB stays OUT of git (binary SQLite, written constantly; restoring it on `git reset`
# brings back an old schema and breaks the bot). universe.json is the only _data file kept.
/statarb_live/_data/*
!/statarb_live/_data/universe.json
/statarb_live/_reports/
statarb_live/deploy/.env
# NOTE: logs/statarb_live IS committed (so the server can push them and you can pull them).
# See .gitattributes (merge=union) — log files auto-merge instead of conflicting.
# Discipline: only the SERVER commits logs; locally just `git pull` to read them.

# auto_commit_bot's own operational log — local only, otherwise every cycle
# would write here and dirty the tree, forcing an empty "no-op" commit each run.
/logs/auto_commit/
